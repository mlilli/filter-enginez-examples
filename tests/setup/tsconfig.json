{
  // Mirrors `tests/tooling/tsconfig.json`: each root-level test directory owns its program, so
  // ESLint's `projectService` resolves these files and typed lint rules run on them. These files run
  // in jsdom under every unit-test runner, so they get the DOM library and no Node types.
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": []
  },
  "include": ["**/*.ts"]
}
