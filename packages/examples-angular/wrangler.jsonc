// Cloudflare Workers deployment of the Angular demo, served at https://angular.filterenginez.com.
// The `deploy` job in .github/workflows/ci.yml builds this package and runs `wrangler deploy` with this file
// on every push to `main` that passes the gates. See "Deployment" in the repository README.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "filter-enginez-angular",
  "compatibility_date": "2026-10-01",
  // The `/books-server` route calls same-origin `/api/*`, which `ng serve` proxies to examples-server on port
  // 24618 (proxy.config.json). Deployed, examples-server's own Worker entry answers those requests instead,
  // and the `/.well-known/*` ones; everything else is a static asset.
  "main": "../examples-server/src/cloudflareWorker.ts",
  "assets": {
    // `@angular/build:application` writes the browser bundle under `<outputPath>/browser` (angular.json).
    "directory": "./dist/browser",
    "binding": "ASSETS",
    // Every page this app routes is a file: the build writes one HTML shell per page, and a 404.html,
    // from the page catalog (scripts/write-route-shells.mjs). The default `html_handling`
    // ("auto-trailing-slash") serves `wine.html` at /wine, and any other path gets 404.html, the app's
    // not-found page, with status 404.
    "not_found_handling": "404-page",
    // The Worker answers `/api/*`, except `/api/corpus/*`: each dataset's corpus is a static file there
    // (`<dataset>.json`, written by the deploy job from examples-server's own route), so serving it
    // costs no Worker CPU. The Workers Free plan allows 10 ms per request, less than serializing a
    // corpus takes. It also answers `/.well-known/*`, with a plain-text 404: the site publishes nothing
    // there, and the not-found page would boot the whole app to say so (examples-server's src/wellKnown.ts).
    "run_worker_first": ["/api/*", "!/api/corpus/*", "/.well-known/*"]
  },
  "routes": [{ "pattern": "angular.filterenginez.com", "custom_domain": true }],
  // The custom domain is the only public address: no *.workers.dev URL, no per-version preview URLs.
  "workers_dev": false,
  "preview_urls": false
}
