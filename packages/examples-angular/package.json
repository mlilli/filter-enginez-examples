{
  "name": "@filter-enginez/examples-angular",
  "version": "0.0.1",
  "description": "Filter EngineZ — Angular 22 demo app (Angular CLI, zoneless, standalone) over @filter-enginez/reactive-rxjs + @filter-enginez/angular-rxjs. The flagship RxJS-surface vertical. Browser-only.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ng serve",
    "build": "ng build && node ../../scripts/preload-fonts.mjs dist/browser/index.html && node ../../scripts/check-font-preloads.mjs dist/browser/index.html && node ../../scripts/check-startup-budget.mjs dist/browser --max-kb 320 && node ../../scripts/strip-local-corpus.mjs dist",
    "preview": "ng serve --configuration production",
    "typecheck": "ngc -p tsconfig.json",
    "test": "ng test --watch=false",
    "lint": "eslint --color --no-error-on-unmatched-pattern .",
    "lint:fix": "pnpm prettier:fix && pnpm eslint:fix",
    "eslint:fix": "eslint --color --no-error-on-unmatched-pattern --fix --max-warnings=0 .",
    "prettier:fix": "prettier --write --ignore-path ../../.prettierignore --ignore-unknown ."
  },
  "dependencies": {
    "@angular/common": "^22.0.7",
    "@angular/compiler": "^22.0.7",
    "@angular/core": "^22.0.7",
    "@angular/platform-browser": "^22.0.7",
    "@angular/router": "^22.0.7",
    "@filter-enginez/angular-rxjs": "0.0.2",
    "@filter-enginez/brand": "workspace:*",
    "@filter-enginez/core": "0.0.2",
    "@filter-enginez/examples-shared": "workspace:*",
    "@filter-enginez/mock-data": "0.1.0",
    "@filter-enginez/reactive-rxjs": "0.0.2",
    "@filter-enginez/ui-styles": "workspace:*",
    "@filter-enginez/url-state-router": "0.0.2",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.0.7",
    "@angular/cli": "^22.0.7",
    "@angular/compiler-cli": "^22.0.7",
    "@filter-enginez/eslint": "0.0.2",
    "angular-eslint": "^22.1.0"
  }
}
