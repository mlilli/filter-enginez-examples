// Cloudflare Workers deployment of the documentation site, served at https://docs.filterenginez.com.
// The `deploy` job in .github/workflows/ci.yml builds this package and runs `wrangler deploy` with this file
// on every push to `main` that passes the gates. See "Deployment" in the repository README.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "filter-enginez-docs",
  "compatibility_date": "2026-10-01",
  // Static assets, and a Worker for one path: `/.well-known/*`, which it answers with a 404. The site
  // publishes nothing there, and the fallback below would answer with index.html and a 200. The Worker
  // is examples-server's src/staticAssetsWorker.ts, which holds that answer and nothing else
  // (src/wellKnown.ts); no other request runs it, so none is billed as a Worker invocation.
  "main": "../examples-server/src/staticAssetsWorker.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Client-side routing (React Router's browser history): any other path gets index.html.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/.well-known/*"]
  },
  "routes": [{ "pattern": "docs.filterenginez.com", "custom_domain": true }],
  // The custom domain is the only public address: no *.workers.dev URL, no per-version preview URLs.
  "workers_dev": false,
  "preview_urls": false
}
