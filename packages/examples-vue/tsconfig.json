// noEmit Vite + Vue app config, type-checked via `vue-tsc --noEmit`. Bundler resolution (Vite owns the
// build); references the sibling packages' composite build configs so cross-package imports resolve to
// their built `.d.ts`. Includes `.vue` SFCs (vue-tsc understands them) + test files.
{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "tsBuildInfoFile": "./tsconfig.tsbuildinfo",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "composite": false,
    "noEmit": true,
    "jsx": "preserve",
    "types": ["vite/client"]
  },
  "include": ["src/**/*", "src/**/*.vue", "env.d.ts"],
  "exclude": ["dist", "node_modules"],
  "references": [{ "path": "../brand/tsconfig.build.json" }, { "path": "../examples-shared/tsconfig.build.json" }]
}
