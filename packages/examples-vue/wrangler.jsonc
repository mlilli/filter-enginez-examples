// Cloudflare Workers deployment of the Vue demo, served at https://vue.filterenginez.com.
// The `deploy` job in .github/workflows/ci.yml builds this package and runs `wrangler deploy` with this file
// on every push to `main` that passes the gates. See "Deployment" in the repository README.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "filter-enginez-vue",
  "compatibility_date": "2026-10-01",
  // Static assets only: no Worker script runs, and no request is billed as a Worker invocation.
  "assets": {
    "directory": "./dist",
    // Client-side routing (Vue Router's `createWebHistory`): any other path gets index.html.
    "not_found_handling": "single-page-application"
  },
  "routes": [{ "pattern": "vue.filterenginez.com", "custom_domain": true }],
  // The custom domain is the only public address: no *.workers.dev URL, no per-version preview URLs.
  "workers_dev": false,
  "preview_urls": false
}
