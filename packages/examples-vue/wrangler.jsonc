// Cloudflare Workers deployment of the Vue demo, served at https://vue.filterenginez.com.
// The `deploy` job in .github/workflows/ci.yml builds this package and runs `wrangler deploy` with this file
// on every push to `main` that passes the gates. See "Deployment" in the repository README.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "filter-enginez-vue",
  "compatibility_date": "2026-10-01",
  // Static assets, and a Worker for one path: `/.well-known/*`, which it answers with a plain-text 404.
  // The site publishes nothing there, and the not-found page below would boot the whole app to say so.
  // The Worker is examples-server's src/staticAssetsWorker.ts, which holds that answer and nothing else
  // (src/wellKnown.ts); no other request runs it, so none is billed as a Worker invocation.
  "main": "../examples-server/src/staticAssetsWorker.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Every page this app routes is a file: the build writes one HTML shell per page, and a 404.html,
    // from the page catalog (scripts/write-route-shells.mjs). The default `html_handling`
    // ("auto-trailing-slash") serves `wine.html` at /wine, and any other path gets 404.html, the app's
    // not-found page, with status 404.
    "not_found_handling": "404-page",
    "run_worker_first": ["/.well-known/*"]
  },
  "routes": [{ "pattern": "vue.filterenginez.com", "custom_domain": true }],
  // The custom domain is the only public address: no *.workers.dev URL, no per-version preview URLs.
  "workers_dev": false,
  "preview_urls": false
}
