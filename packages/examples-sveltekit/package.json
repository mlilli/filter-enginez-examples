{
  "name": "@filter-enginez/examples-sveltekit",
  "version": "0.0.1",
  "description": "Filter EngineZ — SvelteKit demo app over @filter-enginez/svelte-signals. Shows the framework-agnostic engine + reactive-surface binding outside React. Browser + server (SSR on Node or Cloudflare Workers).",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && node ../../scripts/strip-local-corpus.mjs build .svelte-kit/output",
    "preview": "vite preview",
    "prepare": "svelte-kit sync",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest --watch=false --passWithNoTests",
    "lint": "eslint --color --no-error-on-unmatched-pattern .",
    "lint:fix": "pnpm prettier:fix && pnpm eslint:fix",
    "eslint:fix": "eslint --color --no-error-on-unmatched-pattern --fix --max-warnings=0 .",
    "prettier:fix": "prettier --write --ignore-path ../../.prettierignore --ignore-unknown ."
  },
  "dependencies": {
    "@filter-enginez/brand": "workspace:*",
    "@filter-enginez/core": "0.0.2",
    "@filter-enginez/examples-server": "workspace:*",
    "@filter-enginez/examples-shared": "workspace:*",
    "@filter-enginez/mock-data": "0.1.0",
    "@filter-enginez/reactive-signals": "0.0.2",
    "@filter-enginez/svelte-signals": "0.0.2",
    "@filter-enginez/ui-styles": "workspace:*",
    "@filter-enginez/url-state-router": "0.0.2",
    "leaflet": "1.9.4",
    "roaring-wasm": "^1.1.0"
  },
  "devDependencies": {
    "@filter-enginez/eslint": "0.0.2",
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.69.3",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@testing-library/svelte": "^5.4.2",
    "eslint-plugin-svelte": "^3.20.0",
    "svelte": "^5.56.5",
    "svelte-check": "^4.7.2",
    "svelte-eslint-parser": "^1.8.0",
    "typescript-eslint": "^8.59.4",
    "vite": "^8.1.5",
    "wrangler": "^4.149.0"
  }
}
