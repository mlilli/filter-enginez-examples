// Type-checks the home page's code (`tsc --noEmit -p src/home`, part of the package's `typecheck`) and
// serves ESLint's typed lint for it. Browser code, so the DOM library; bundler resolution, because Vite
// owns the build. It imports nothing outside this directory, so it references no other project.
{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": []
  },
  "include": ["**/*"],
  "exclude": [],
  "references": []
}
