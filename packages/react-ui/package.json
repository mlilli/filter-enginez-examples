{
  "name": "@filter-enginez/react-ui",
  "version": "0.0.1",
  "description": "Filter EngineZ — React presentational components (dumb, prop-driven; one exported component + props interface per file). No engine / state-library / browser-global imports. Consumes @filter-enginez/ui-styles + @filter-enginez/brand. Browser-only.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./bounds": "./src/sharedContracts.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --build tsconfig.build.json",
    "test": "vitest --watch=false --passWithNoTests",
    "lint": "eslint --color --no-error-on-unmatched-pattern .",
    "lint:fix": "pnpm prettier:fix && pnpm eslint:fix",
    "eslint:fix": "eslint --color --no-error-on-unmatched-pattern --fix --max-warnings=0 .",
    "prettier:fix": "prettier --write --ignore-path ../../.prettierignore --ignore-unknown ."
  },
  "dependencies": {
    "@filter-enginez/brand": "workspace:*",
    "@filter-enginez/ui-styles": "workspace:*",
    "radix-ui": "^1.4.3"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@filter-enginez/eslint": "0.0.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "react-dom": "^19.2.8"
  }
}
