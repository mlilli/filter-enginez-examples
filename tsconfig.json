// TypeScript SOLUTION file: owns no files; wires the project-reference graph for
// `tsc --build` and editors. References each composite package's `tsconfig.build.json`
// (the emit configs). Day-to-day typecheck runs each package's own `tsc --noEmit`
// (= `turbo run typecheck`) against its `tsconfig.json`, which includes tests.
{
  "$schema": "https://json.schemastore.org/tsconfig",
  "files": [],
  "references": [
    {
      "path": "./packages/brand/tsconfig.build.json"
    },
    {
      "path": "./packages/react-ui/tsconfig.build.json"
    },
    {
      "path": "./packages/examples-shared/tsconfig.build.json"
    }
  ]
}
