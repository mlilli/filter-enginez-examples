{
  "name": "filter-enginez-examples",
  "version": "0.1.0",
  "private": true,
  "description": "Filter EngineZ examples — six demo apps (React + RTK, React, SvelteKit, Vue, Angular, framework-free) over three datasets. Not published.",
  "author": "Michael Lilli",
  "license": "Apache-2.0",
  "homepage": "https://filterenginez.com",
  "keywords": [
    "data filtering",
    "filter engine",
    "isomorphic",
    "typescript"
  ],
  "type": "module",
  "packageManager": "pnpm@12.11.2+sha512.25a51652a196785af5f28bda6dfe8dc582ebefa4ac1d180221ce1390231c5fb76637822ea4b6e4633ce74acdcb0a77f725af11bad38177fdeddaee818a955cb9",
  "engines": {
    "node": ">=v24.18.0",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "check:node": "node scripts/check-node-version.mjs",
    "clean": "turbo clean && find . -name 'node_modules' -type d -prune -exec rm -rf '{}' +",
    "cspell": "cspell lint --cache --cache-location .cache/cspell/.cspellcache --no-must-find-files \"**/*.{cjs,css,html,js,json,jsx,mjs,md,mdx,scss,ts,tsx,yml,yaml}\"",
    "cspell:files": "cspell lint --cache --cache-location .cache/cspell/.cspellcache --no-must-find-files",
    "dev": "turbo run dev",
    "dev:angular": "turbo run dev --filter @filter-enginez/examples-angular",
    "dev:api": "pnpm --filter @filter-enginez/examples-server serve:api",
    "dev:docs": "pnpm --filter @filter-enginez/examples-docs dev",
    "dev:fresh": "turbo run dev -- --force",
    "dev:plain": "turbo run dev --filter=@filter-enginez/examples-react-plain",
    "dev:plain:default": "VITE_WINE_TIER=default turbo run dev --filter=@filter-enginez/examples-react-plain",
    "dev:plain:default:fresh": "VITE_WINE_TIER=default turbo run dev --filter=@filter-enginez/examples-react-plain -- --force",
    "dev:plain:fresh": "turbo run dev --filter=@filter-enginez/examples-react-plain -- --force",
    "dev:rtk": "turbo run dev --filter=@filter-enginez/examples-react-rtk",
    "dev:rtk:default": "VITE_WINE_TIER=default turbo run dev --filter=@filter-enginez/examples-react-rtk",
    "dev:rtk:default:fresh": "VITE_WINE_TIER=default turbo run dev --filter=@filter-enginez/examples-react-rtk -- --force",
    "dev:rtk:fresh": "turbo run dev --filter=@filter-enginez/examples-react-rtk -- --force",
    "dev:site": "pnpm --filter @filter-enginez/site dev",
    "dev:svelte": "turbo run dev --filter=@filter-enginez/examples-sveltekit",
    "dev:vanilla": "turbo run dev --filter @filter-enginez/examples-vanilla",
    "dev:vue": "turbo run dev --filter=@filter-enginez/examples-vue",
    "docs:site": "pnpm --filter @filter-enginez/examples-docs build",
    "lint": "turbo run lint --continue && eslint . --max-warnings=0",
    "lint:fix": "turbo run lint:fix --continue && eslint . --fix --max-warnings=0",
    "lint:markdown": "markdownlint-cli2",
    "lint:markdown:fix": "markdownlint-cli2 --fix",
    "prepare": "husky",
    "pretest:e2e": "node scripts/check-node-version.mjs && node scripts/check-e2e-ports.mjs && bash scripts/clear-angular-cache.sh",
    "pretest:e2e:failed": "node scripts/check-node-version.mjs && node scripts/check-e2e-ports.mjs && bash scripts/clear-angular-cache.sh",
    "pretest:e2e:ui": "node scripts/check-node-version.mjs && node scripts/check-e2e-ports.mjs && bash scripts/clear-angular-cache.sh",
    "prettier:check": "prettier --check --ignore-path ./.prettierignore --ignore-unknown '**/*.{cjs,css,js,json,mjs,md,mdx,scss,ts,yml,yaml}'",
    "prettier:fix": "turbo run prettier:fix --continue",
    "link:wine-corpus": "node scripts/link-wine-corpus.mjs",
    "measure:verticals": "node scripts/measure-verticals.mjs",
    "size": "size-limit",
    "size:json": "size-limit --json",
    "sync:brand-assets": "node scripts/sync-brand-assets.mjs",
    "sync:brand-assets:check": "node scripts/sync-brand-assets.mjs --check",
    "test": "vitest run",
    "test:changed": "vitest --watch=false --passWithNoTests --changed",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:failed": "playwright test --last-failed",
    "test:e2e:ui": "playwright test --ui",
    "test:frameworks": "pnpm --filter @filter-enginez/examples-vue --filter @filter-enginez/examples-sveltekit --filter @filter-enginez/examples-angular test",
    "test:min": "vitest --watch=false --passWithNoTests --reporter=dot 2>&1 | grep -E \"FAIL|[0-9]+:[0-9]+$\"",
    "test:ui": "vitest --watch=false --passWithNoTests --ui",
    "test:watch": "vitest --passWithNoTests",
    "typecheck": "turbo run typecheck && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tests/e2e/tsconfig.json && tsc --noEmit -p tests/tooling/tsconfig.json",
    "typecheck:build": "tsc --build"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/config-helpers": "^0.7.0",
    "@filter-enginez/eslint": "0.0.3",
    "@playwright/test": "^1.63.0",
    "@size-limit/preset-small-lib": "^13.1.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^24.19.1",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vitest/ui": "^4.1.11",
    "cspell": "^9.8.0",
    "eslint": "^10.12.0",
    "eslint-plugin-compat": "^7.0.2",
    "eslint-plugin-perfectionist": "^5.12.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^28.1.0",
    "lint-staged": "^15.5.2",
    "markdownlint-cli2": "^0.23.3",
    "prettier": "^3.9.9",
    "size-limit": "^13.1.1",
    "turbo": "^2.11.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^4.1.11",
    "wrangler": "^4.149.0"
  },
  "browserslist": [
    "defaults and fully supports es6-module",
    "maintained node versions"
  ]
}
